                  "        'Falta tokenB. Copialo del log de la reinvitacion (carpeta 3) y pegalo ' +",
                  "        'en Variables > Current value.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
