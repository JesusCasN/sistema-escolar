          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('tokenA')) {",
                  "    throw new Error(",
                  "        'Falta tokenA. Copialo del log del primer alta (bloque INVITACION, ' +",
                  "        'lo que va despues de /invitacion/) y pegalo en Variables > Current value.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('410 Gone: reinvitar invalido el token anterior', () => {",
