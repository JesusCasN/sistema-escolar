            },
            "url": {
              "raw": "{{baseUrl}}/invitaciones/{{tokenB}}/aceptar",
              "host": ["{{baseUrl}}"],
              "path": ["invitaciones", "{{tokenB}}", "aceptar"]
            },
            "description": "Regla que no se puede expresar con anotaciones: la contrasena es obligatoria solo cuando el metodo es PASSWORD. La lanza el service como IllegalArgumentException y el handler la traduce a 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Aceptar -> 200 ACTIVO",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"PASSWORD\",\n  \"password\": \"contrasena-larga-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invitaciones/{{tokenB}}/aceptar",
              "host": ["{{baseUrl}}"],
              "path": ["invitaciones", "{{tokenB}}", "aceptar"]
            },
            "description": "En UNA sola transaccion: se hashea la contrasena con Argon2id, se activa el usuario, se marca la invitacion como usada y se registra usuario.activado en el outbox.\n\nSi cualquiera de los cuatro falla se revierten los cuatro. Ese es el punto del patron outbox: es imposible que quede un usuario activo sin su evento, o un evento de un usuario que no se activo.\n\nVERIFICA DESPUES en terminal que el evento haya llegado a Kafka."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('la cuenta queda ACTIVA', () => {",
                  "    pm.expect(body.estado).to.eql('ACTIVO');",
                  "});",
                  "",
                  "pm.test('ya no hay invitacion vigente', () => {",
                  "    pm.expect(body.invitacionExpiraEn).to.be.null;",
                  "});",
                  "",
                  "pm.test('nunca devuelve la contrasena ni su hash', () => {",
                  "    const texto = pm.response.text();",
                  "    pm.expect(texto).to.not.include('contrasena-larga-123');",
                  "    pm.expect(texto).to.not.include('argon2');",
                  "});",
                  "",
                  "console.log('>>> Verifica el outbox: select type, published_at from outbox_event;');"
                ]
              }
            }
          ]
        },
        {
          "name": "Reusar el token aceptado -> 410  [SEGURIDAD]",
